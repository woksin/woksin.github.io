---
import { cratis, person, type CratisRepo } from '../data/site';
import SectionHeader from './SectionHeader.astro';
import { github, mergedPrFloor, mergedPrTotal, snapshotDate } from '../lib/github';
import { relativeTime } from '../lib/reltime';

// The section shows the newest eight; the terminal's `stream tail` gets the full snapshot.
const feed = github.mergedPullRequests.latest.slice(0, 8);
const builtAt = Date.parse(github.fetchedAt);

const fmt = new Intl.NumberFormat('en-US');
const byName = new Map(cratis.repos.map((r) => [r.name, r]));
const pipeline = cratis.pipeline.map((n) => byName.get(n)).filter((r): r is CratisRepo => !!r);
const tooling = cratis.repos.filter((r) => r.group === 'tooling');
const clients = cratis.repos.filter((r) => r.group === 'client');
const asOf = new Date(`${cratis.asOf}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

const headline = [
  { value: `#1`, label: `committer on ${cratis.repos.filter((r) => r.rank === 1).length} Cratis repositories` },
  { value: String(cratis.repos.filter((r) => r.founded).length), label: `repositories founded: ${cratis.repos.filter((r) => r.founded).map((r) => r.name).join(', ')}` },
  { value: String(cratis.clientLanguages.length), label: `Chronicle client languages: ${cratis.clientLanguages.join(', ')}` },
  { value: `${fmt.format(mergedPrFloor)}+`, label: `merged PRs in the Cratis org, live (${fmt.format(mergedPrTotal)} at the last build)` },
];
const badge = (r: CratisRepo) => (r.founded ? 'b-founded' : r.rank === 1 ? 'b-lead' : 'b-muted');
---

<section id="cratis" class="relative overflow-hidden py-24 md:py-36" aria-labelledby="cratis-title">
  <div class="pointer-events-none absolute top-1/3 -right-40 size-[40rem] rounded-full bg-command/10 blur-[120px]" aria-hidden="true"></div>
  <div class="container-x relative">
    <SectionHeader index="04" kind="command" label="Co-founder · Chief Architect" title="What I lead at Cratis." id="cratis-title">
      <div class="mt-6 grid max-w-[64ch] gap-4 text-lg leading-relaxed">
        <p class="text-fg">{cratis.pitch}</p>
        <p class="text-fg-muted">
          Cratis is a company of two: <a href={cratis.about} class="text-fg underline decoration-line-strong hover:decoration-fg" rel="noopener">{cratis.cofounder} and me</a>.
          I lead the stack from model to running app: the Screenplay language, the Stage renderer, the AI corpus, the cli and most Chronicle clients.
        </p>
      </div>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={person.links.cratis} class="btn btn-sm" rel="noopener">cratis.io <span aria-hidden="true">↗</span></a>
        <a href={person.links.cratisGithub} class="btn btn-sm" rel="noopener">github.com/Cratis <span aria-hidden="true">↗</span></a>
      </div>
    </SectionHeader>

    <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line lg:grid-cols-4" data-reveal>
      {
        headline.map((h, i) => (
          <div class="flex flex-col bg-ink-900 p-5 md:p-6">
            <dt class="order-2 mt-2 text-sm leading-snug text-fg-muted">{h.label}</dt>
            <dd class={`order-1 font-display text-[clamp(2.25rem,4.4vw,3.5rem)] leading-none font-[680] tracking-[-0.04em] tabular-nums ${['text-command', 'text-event', 'text-view', 'text-fg'][i]}`}>{h.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-16 md:mt-20" data-reveal>
      <div class="mb-5 flex flex-wrap items-baseline justify-between gap-3">
        <h3 class="font-display text-2xl font-[620] tracking-[-0.02em]">From model to running app</h3>
        <p class="font-mono text-xs text-fg-faint">commits and merged PRs are mine, all-time, as of {asOf}</p>
      </div>
      <ol class="pipeline grid gap-4 lg:grid-cols-4" aria-label="The Cratis pipeline">
        {
          pipeline.map((r, i) => (
            <li class="relative">
              <a href={r.url} rel="noopener" class="panel glow group flex h-full flex-col p-5" style="--glow: var(--color-command)">
                <span class="flex items-center justify-between gap-2 font-mono text-[0.6875rem]">
                  <span class="text-fg-faint">{String(i + 1).padStart(2, '0')} · {r.step}</span>
                  <span class={`badge ${badge(r)}`}>{r.role}</span>
                </span>
                <span class="mt-6 font-display text-3xl font-[650] tracking-[-0.03em] transition-colors group-hover:text-command-soft">{r.name}</span>
                <span class="note note-command mt-1">{r.kind}</span>
                <span class="mt-3 text-sm leading-relaxed text-fg-muted">{r.desc}</span>
                <span class="mt-auto flex gap-4 pt-5 font-mono text-xs text-fg-faint tabular-nums">
                  <span><span class="text-fg">{fmt.format(r.commits)}</span> commits</span>
                  <span><span class="text-fg">{fmt.format(r.prs)}</span> PRs</span>
                  {github.stars[r.name] !== undefined && <span class="ml-auto" aria-label={`${github.stars[r.name]} stars on GitHub`}>★ {github.stars[r.name]}</span>}
                </span>
              </a>
              {i < pipeline.length - 1 && <span class="flow" aria-hidden="true"></span>}
            </li>
          ))
        }
      </ol>
    </div>

    <div class="mt-6 grid gap-4 lg:grid-cols-12" data-reveal>
      <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-8" aria-label="Around the pipeline">
        {
          tooling.map((r) => {
            const Tag = r.url ? 'a' : 'div';
            return (
              <li>
                <Tag href={r.url} rel={r.url ? 'noopener' : undefined} class:list={['panel flex h-full flex-col p-5', r.url && 'glow group']} style="--glow: var(--color-command)">
                  <span class="flex items-center justify-between gap-2 font-mono text-[0.6875rem]">
                    <span class="note note-command">{r.kind}</span>
                    <span class={`badge ${badge(r)}`}>{r.role}</span>
                  </span>
                  <span class="mt-4 font-display text-xl font-[640] tracking-[-0.02em] transition-colors group-hover:text-command-soft">{r.name}</span>
                  <span class="mt-1.5 text-sm leading-relaxed text-fg-muted">{r.desc}</span>
                  {r.note && <span class="mt-2 font-mono text-xs text-view">{r.note}</span>}
                  <span class="mt-auto flex gap-4 pt-4 font-mono text-xs text-fg-faint tabular-nums">
                    <span><span class="text-fg">{fmt.format(r.commits)}</span> commits</span>
                    <span><span class="text-fg">{fmt.format(r.prs)}</span> PRs</span>
                  </span>
                </Tag>
              </li>
            );
          })
        }
      </ul>
      <div class="panel p-5 lg:col-span-4">
        <p class="note">Chronicle clients</p>
        <p class="mt-3 font-display text-xl font-[640] tracking-[-0.02em]">{cratis.clientLanguages.length} languages</p>
        <p class="mt-1 text-sm text-fg-muted">{cratis.clientLanguages.join(' · ')}. The .NET client ships with Chronicle.</p>
        <ul class="mt-4 divide-y divide-line border-t border-line">
          {
            clients.map((r) => (
              <li>
                <a href={r.url} rel="noopener" class="group flex items-start justify-between gap-3 py-3">
                  <span class="min-w-0">
                    <span class="block font-mono text-sm text-fg group-hover:underline">{r.name}</span>
                    <span class="block text-xs leading-relaxed text-fg-muted">{r.desc}</span>
                  </span>
                  <span class="shrink-0 text-right">
                    <span class={`badge ${badge(r)}`}>{r.role}</span>
                    <span class="mt-1 block font-mono text-[0.6875rem] text-fg-faint tabular-nums">{fmt.format(r.commits)} commits</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-16 grid gap-6 md:mt-20 lg:grid-cols-12">
      <div class="panel overflow-hidden lg:col-span-7" data-reveal data-feed>
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line px-5 py-3.5">
          <h3 class="flex items-center gap-2.5 font-mono text-sm">
            <span class="size-1.5 animate-pulse-dot rounded-full bg-view" aria-hidden="true"></span>
            <span class="text-fg-faint">tail -f</span> <span class="text-fg">Tailing the stream</span>
          </h3>
          <p class="font-mono text-xs text-fg-faint">snapshot taken <time datetime={github.fetchedAt}>{snapshotDate()}</time></p>
        </div>
        {
          feed.length ? (
            <ol class="divide-y divide-line" aria-label={`Latest merged pull requests in ${github.org}`}>
              {feed.map((pr, i) => (
                <li class="feed-row" style={`--i:${i}`}>
                  <a href={pr.url} rel="noopener" class="group grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 px-5 py-3.5 transition-colors hover:bg-fg/[0.025] sm:grid-cols-[4.5rem_1fr_auto]">
                    <span class="font-mono text-xs leading-6 text-fg-faint tabular-nums">{i === 0 ? 'HEAD' : `HEAD~${i}`}</span>
                    <span class="min-w-0">
                      <span class="flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-xs">
                        <span class="text-event">PullRequestMerged</span>
                        <span class="rounded-md border border-command/25 bg-command/8 px-1.5 py-px text-command-soft">{github.org}/{pr.repo}</span>
                        <span class="text-fg-faint">#{pr.number}</span>
                      </span>
                      <span class="mt-1 block text-[0.9375rem] leading-snug text-fg group-hover:underline">{pr.title}</span>
                    </span>
                    <time datetime={pr.mergedAt} data-rel class="col-start-2 font-mono text-xs text-fg-faint sm:col-start-3 sm:leading-6">{relativeTime(pr.mergedAt, builtAt)}</time>
                  </a>
                </li>
              ))}
            </ol>
          ) : (
            <p class="px-5 py-8 font-mono text-sm text-fg-faint">EventNotFound: the snapshot has no merged pull requests yet.</p>
          )
        }
        <p class="border-t border-line px-5 py-3 font-mono text-[0.6875rem] text-fg-faint">
          Public repositories only, newest first. Refreshed on every daily build.
        </p>
      </div>

      <div class="lg:col-span-5" data-reveal style="--reveal-delay:120ms">
        <h3 class="font-display text-2xl font-[620] tracking-[-0.02em]">Highlights from the log</h3>
        <p class="mt-2 text-fg-muted">A few of the changes I have landed in Cratis.</p>
        <ol class="panel mt-6 divide-y divide-line overflow-hidden font-mono text-sm" aria-label="Highlights">
          {
            cratis.highlights.map((h) => (
              <li class="flex items-start gap-3 px-5 py-3.5 transition-colors hover:bg-fg/[0.02]">
                <svg viewBox="0 0 16 16" class="mt-0.5 size-4 shrink-0 text-[#a371f7]" fill="currentColor" aria-label="merged" role="img">
                  <path d="M5.45 5.154A4.25 4.25 0 0 0 9.25 7.5h1.378a2.251 2.251 0 1 1 0 1.5H9.25A5.734 5.734 0 0 1 5 7.123v3.505a2.25 2.25 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.95-.218ZM4.25 13.5a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm8.5-4.5a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5ZM5 3.25a.75.75 0 1 0 0 .005V3.25Z" />
                </svg>
                <span class="text-fg">{h}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .badge {
    display: inline-block;
    border-radius: 999px;
    padding: 0.05rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    white-space: nowrap;
    border: 1px solid var(--color-line);
    color: var(--color-fg-muted);
  }
  .b-founded {
    color: var(--color-event-soft);
    border-color: color-mix(in oklab, var(--color-event) 45%, transparent);
    background: color-mix(in oklab, var(--color-event) 10%, transparent);
  }
  .b-lead {
    color: var(--color-command-soft);
    border-color: color-mix(in oklab, var(--color-command) 45%, transparent);
    background: color-mix(in oklab, var(--color-command) 10%, transparent);
  }
  /* Connector between pipeline stages, with a pulse travelling along it. */
  .flow {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: -1rem;
    width: 1px;
    height: 1rem;
    background: linear-gradient(var(--color-command), var(--color-event));
    overflow: hidden;
  }
  @media (min-width: 1024px) {
    .flow {
      left: auto;
      right: -1rem;
      bottom: auto;
      top: 50%;
      width: 1rem;
      height: 1px;
      background: linear-gradient(90deg, var(--color-command), var(--color-event));
    }
  }
  .flow::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #fff;
    opacity: 0;
  }
  :global(.js-motion) .flow::after {
    animation: flow-pulse 2.4s ease-in-out infinite;
  }
  .pipeline > li:nth-child(2) .flow::after { animation-delay: 0.6s; }
  .pipeline > li:nth-child(3) .flow::after { animation-delay: 1.2s; }
  @keyframes flow-pulse {
    0%, 100% { opacity: 0; }
    50% { opacity: 0.9; }
  }
  :global(.js-motion) [data-feed].is-visible .feed-row {
    animation: feed-in 700ms var(--ease-out-expo) both;
    animation-delay: calc(var(--i) * 45ms + 200ms);
  }
  @keyframes feed-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
</style>

<script>
  import { hydrateRelativeTimes } from '../lib/reltime';
  import { onPageLoad } from '../lib/lifecycle';
  onPageLoad(() => hydrateRelativeTimes(document.querySelector('[data-feed]') ?? document));
</script>
