---
import { liveProjects as projects } from '../lib/github';
import SectionHeader from './SectionHeader.astro';

const filters = [
  { id: 'all', label: 'All' },
  { id: 'cli', label: 'CLI' },
  { id: 'agents', label: 'Agents' },
  { id: 'app', label: 'Apps' },
] as const;
const countFor = (id: string) => (id === 'all' ? projects.length : projects.filter((p) => p.category === id).length);
const categoryLabel = { cli: 'CLI', agents: 'Agent tooling', app: 'App' } as const;
const wide = new Set(['workstats', 'Varde']);
const escape = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
/** Lets a command wrap only after spaces and slashes, with no added visible characters. */
const breakable = (cmd: string) =>
  cmd
    .split(/(?<=[/ ])/)
    .map((part) => `<span class="whitespace-nowrap">${escape(part)}</span>`)
    .join('<wbr>');
---

<section id="projects" class="relative py-24 md:py-36" aria-labelledby="projects-title">
  <div class="container-x">
    <SectionHeader index="07" label="Side projects" title="Things I build after hours." id="projects-title" />

    <div class="mb-8 flex flex-wrap gap-2" role="group" aria-label="Filter projects by category" data-filters hidden>
      {
        filters.map((f, i) => (
          <button type="button" class="filter" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f.label}
            <span class="font-mono text-[0.6875rem] opacity-60">{countFor(f.id)}</span>
          </button>
        ))
      }
    </div>
    <p class="sr-only" aria-live="polite" data-filter-status></p>

    <ul class="bento grid grid-cols-1 gap-4 md:grid-cols-3" data-bento>
      {
        projects.map((p, i) => (
          <li class:list={['proj', wide.has(p.name) && 'md:col-span-2']} data-category={p.category} data-reveal style={`--reveal-delay:${(i % 3) * 70}ms`}>
            <article class="panel glow flex h-full flex-col p-6 md:p-7">
              <header class="flex items-start justify-between gap-4">
                <div>
                  <p class="font-mono text-[0.6875rem] tracking-wider text-fg-faint uppercase">{categoryLabel[p.category]}</p>
                  <h3 class="mt-2 flex items-center gap-3 font-display text-[1.75rem] leading-none font-[650] tracking-[-0.03em]">
                    <a href={p.url} rel="noopener" class="hover:text-event-soft">
                      {p.name}
                    </a>
                    {p.version && (
                      <span class="rounded-md border border-event/30 bg-event/10 px-1.5 py-0.5 font-mono text-[0.6875rem] font-medium tracking-normal text-event-soft">
                        {p.version}
                      </span>
                    )}
                  </h3>
                </div>
                <a href={p.url} rel="noopener" class="grid size-9 shrink-0 place-items-center rounded-lg border border-line text-fg-muted transition-colors hover:border-line-strong hover:text-fg" aria-label={`${p.name} on GitHub`}>
                  <svg viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </a>
              </header>

              <p class="mt-4 text-[1.0625rem] leading-relaxed text-fg">{p.pitch}</p>

              <ul class:list={['mt-5 grid gap-2 text-sm text-fg-muted', wide.has(p.name) && 'sm:grid-cols-2 sm:gap-x-6']}>
                {p.features.map((f) => (
                  <li class="flex gap-2.5">
                    <span class="mt-[0.45rem] size-1.5 shrink-0 rounded-[2px] bg-view/80" aria-hidden="true" />
                    {f}
                  </li>
                ))}
              </ul>

              <div class="mt-auto pt-6">
                {p.install && (
                  <div class="term mb-4 flex items-start gap-2.5 rounded-xl border border-line bg-ink-950/80 py-1.5 pr-1.5 pl-3.5 font-mono text-[0.8125rem] leading-5">
                    <span class="py-[0.3rem] text-view select-none" aria-hidden="true">$</span>
                    <code class="min-w-0 flex-1 py-[0.3rem] [overflow-wrap:anywhere] text-fg">
                      <Fragment set:html={breakable(p.install)} />
                    </code>
                    <button type="button" class="copy" data-copy={p.install} aria-label={`Copy install command for ${p.name}`}>
                      <svg viewBox="0 0 16 16" class="ic-copy size-3.5" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5" y="5" width="9" height="9" rx="2" /><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5" /></svg>
                      <svg viewBox="0 0 16 16" class="ic-ok size-3.5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m3 8.5 3 3 7-7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      <span data-copy-label>Copy</span>
                    </button>
                    <span class="sr-only" aria-live="polite" data-copy-status />
                  </div>
                )}
                <ul class="flex flex-wrap gap-1.5" aria-label="Stack">
                  {p.stack.map((s) => (
                    <li class="rounded-md bg-fg/[0.04] px-2 py-0.5 font-mono text-[0.6875rem] text-fg-muted">{s}</li>
                  ))}
                </ul>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .bento[data-filtered] .proj {
    grid-column: auto;
  }
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 1.9rem;
    padding-inline: 0.6rem;
    border-radius: 0.55rem;
    font-size: 0.75rem;
    color: var(--color-fg-muted);
    border: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-fg) 3%, transparent);
    transition: all 160ms ease;
    cursor: pointer;
    flex-shrink: 0;
  }
  .copy:hover {
    color: var(--color-fg);
    border-color: var(--color-line-strong);
  }
  .copy .ic-ok,
  .copy[data-copied='true'] .ic-copy {
    display: none;
  }
  .copy[data-copied='true'] {
    color: var(--color-view);
    border-color: rgb(61 220 151 / 0.4);
    background: rgb(61 220 151 / 0.08);
  }
  .copy[data-copied='true'] .ic-ok {
    display: block;
  }
  .proj[hidden] {
    display: none;
  }
  :global(.js-motion) .proj.enter {
    animation: var(--animate-pop-in);
  }
</style>

<script>
  import { onPageLoad } from '../lib/lifecycle';
  onPageLoad(() => {
    const bar = document.querySelector<HTMLElement>('[data-filters]');
    const grid = document.querySelector<HTMLElement>('[data-bento]');
    const status = document.querySelector<HTMLElement>('[data-filter-status]');
    if (bar && grid) {
      bar.hidden = false;
      const cards = [...grid.querySelectorAll<HTMLElement>('.proj')];
      bar.addEventListener('click', (e) => {
        const btn = (e.target as Element).closest<HTMLButtonElement>('[data-filter]');
        if (!btn) return;
        const id = btn.dataset['filter'];
        bar.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        grid.toggleAttribute('data-filtered', id !== 'all');
        let shown = 0;
        for (const card of cards) {
          const match = id === 'all' || card.dataset['category'] === id;
          card.hidden = !match;
          card.classList.remove('enter');
          if (match) {
            shown++;
            void card.offsetWidth;
            card.classList.add('enter', 'is-visible');
          }
        }
        if (status) status.textContent = `Showing ${shown} project${shown === 1 ? '' : 's'}`;
      });
    }
  });
</script>
